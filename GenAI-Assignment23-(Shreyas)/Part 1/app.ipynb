   "source": [
    "from langchain_openai import ChatOpenAI\n",
    "from dotenv import load_dotenv\n",
    "load_dotenv()\n",
    "LLM = ChatOpenAI(\n",
    "    model=\"gpt-4o-mini\",\n",
    "    temperature=0.5\n",
    ")\n",
    "response = LLM.invoke(\"Explain Artificial Intelligence in simple words.\")\n",
    "print(response.content)"
   ]
  }
